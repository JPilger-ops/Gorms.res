# Public guest-facing site
NEXT_PUBLIC_SITE_URL=https://heidekönig.gorms.de
PUBLIC_HOST=heidekönig.gorms.de
PUBLIC_ALLOWED_HOSTS=heidekönig.gorms.de,xn--heideknig-57a.gorms.de

# Admin/backend site
ADMIN_APP_URL=https://login.gorms.de
ADMIN_HOST=login.gorms.de
ADMIN_ALLOWED_HOSTS=login.gorms.de

# App runtime
APP_NAME=Waldwirtschaft Heidekönig
PORT=6043
HOSTNAME=0.0.0.0
UPLOAD_DIR=/app/uploads

# Cookies
ADMIN_SESSION_COOKIE_NAME=heidekoenig_admin_session
# Keep empty for host-only cookies. Do not use .gorms.de.
ADMIN_COOKIE_DOMAIN=

# Database
POSTGRES_DB=heidekoenig
POSTGRES_APP_USER=heidekoenig_app
POSTGRES_APP_PASSWORD=change-this-password
DATABASE_URL=postgres://heidekoenig_app:change-this-password@db:5432/heidekoenig

# App Security
# Optional. If empty, the app creates a persistent key in APP_ENCRYPTION_KEY_FILE during setup.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_FILE=/app/secrets/app_encryption_key
SESSION_SECRET=change-this-session-secret
SETUP_TOKEN=change-this-one-time-setup-token
RUN_MIGRATIONS_ON_START=false

# AI assistant preparation. Disabled by default; no automatic guest data processing in V1.1.
AI_ENABLED=false
OLLAMA_BASE_URL=http://vault.local:11434
OLLAMA_MODEL=qwen3:8b
AI_TIMEOUT_MS=120000

# Optional initial admin CLI seed
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Mail / SMTP defaults
SMTP_PROVIDER=ionos
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Waldwirtschaft Heidekönig
SMTP_FROM_ADDRESS=
RESERVATION_NOTIFICATION_EMAIL=Welcome@der-heidekoenig.de
INTERNAL_EMAIL_SUBJECT_TEMPLATE=Neue Reservierungsanfrage: {{date}} um {{time}} - {{guestName}} - {{guestCount}} Personen
GUEST_EMAIL_SUBJECT_TEMPLATE=Ihre Reservierungsanfrage bei der Waldwirtschaft Heidekönig

# Business Rules
HOLIDAY_COUNTRY=DE
# date-holidays uses NW for Nordrhein-Westfalen. NRW is accepted by app normalization.
HOLIDAY_STATE=NW
BLOCK_MONDAYS=true
BLOCK_TUESDAYS=true
BLOCK_SUNDAYS=true
BLOCK_PUBLIC_HOLIDAYS=true
MAX_GUESTS_PER_REQUEST=70
EARLIEST_RESERVATION_TIME=11:30
LATEST_RESERVATION_TIME=18:00
SUMMER_SEASON_START=04-01
SUMMER_SEASON_END=10-31
SUMMER_KITCHEN_ACCEPTANCE_UNTIL=19:00
WINTER_KITCHEN_ACCEPTANCE_UNTIL=18:00
LATEST_RESERVATION_BUFFER_MINUTES=60
RESERVATION_SLOT_MINUTES=30
STANDARD_OCCUPANCY_MINUTES=120
INDOOR_CAPACITY=70
MANUAL_REVIEW_GUEST_THRESHOLD=30

# Privacy / Retention
PRIVACY_CONTACT_EMAIL=
PRIVACY_NOTICE_TEXT=Wir verwenden Ihre Angaben ausschließlich zur Bearbeitung Ihrer Reservierungsanfrage.
PRIVACY_POLICY_URL=
IMPRINT_URL=
RESERVATION_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=30

# Backups via NFS mount
BACKUP_TARGET=nfs
# NAS export to mount on the Docker host; Compose uses BACKUP_HOST_PATH after it is mounted.
BACKUP_NFS_EXPORT=192.100.100.152:/mnt/Vault/Backups/Backup_Gorms.Res
BACKUP_HOST_PATH=/mnt/heidekoenig-backups
BACKUP_CONTAINER_PATH=/backups
BACKUP_SCHEDULE=0 3 * * *

# Reverse Proxy
REVERSE_PROXY_NETWORK=optional-proxy-network-name
